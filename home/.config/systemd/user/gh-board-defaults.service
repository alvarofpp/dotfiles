[Unit]
# O workflow "Item added to project" do GitHub só aplica default a UM campo
# (Status). Priority fica de fora, então quem preenche é o `task gh:defaults`.
Description=Tick do GitHub Project "Agentes" — defaults de campo + despacho das issues em Ready
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/home/alvaro/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=%h
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:defaults
# Ready -> worktree Orca com agente. Sai em silêncio se o Orca estiver fora.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:dispatch
# PR do fluxo -> revisar / corrigir / mergear. Idem: no-op sem Orca.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:pr-tick
StandardOutput=journal
StandardError=journal
