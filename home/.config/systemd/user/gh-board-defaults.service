[Unit]
# Tick do fluxo autônomo. O estado é o Status da issue no board — cada ExecStart
# lê uma coluna e age. A ordem importa: liberar lock e destravar Blocked vem
# antes de despachar, pra o que destravou entrar no mesmo tick.
Description=Tick do GitHub Project "Agentes" — triagem, implementação, review e fechamento
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Sem isto o default de oneshot é `infinity`, e tick que trava trava o FLUXO:
# o timer não dispara enquanto a passada anterior estiver de pé, então nada
# anda e nada avisa. Em 2026-09-12 uma passada ficou das 13:52 às 18:57 — 5h
# com 3min50s de CPU, ou seja parada esperando — e o `gh:unstick` do PR #233 do
# abacaxei-app, que é dos últimos da fila, só rodou duas passadas depois.
# 45 min é o dobro do tick mais lento já medido (27 min, quando o `gh:sync`
# ainda re-adicionava o board inteiro). Morto por timeout, o próximo tick nasce
# limpo e o `gh:reap` solta o lock que a passada interrompida tenha deixado.
TimeoutStartSec=2700
Environment=PATH=/home/alvaro/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=%h
# Vigia do portão: avisa no Telegram quando o fluxo passa 3 ticks desligado.
# Primeiro de propósito — é o que responde "este tick vale alguma coisa?".
ExecStart=%h/.local/bin/gh-tick-step gh:gate-watch
# Issue cujo agente morreu perde o lock e volta pra fila.
ExecStart=%h/.local/bin/gh-tick-step gh:reap
ExecStart=%h/.local/bin/gh-tick-step gh:sweep
# Ready -> triagem (/issue-prep). Síncrono: nada de worktree nesta fase.
ExecStart=%h/.local/bin/gh-tick-step gh:prep
# Em 2026-10-16 sync, unblock, answer, dispatch, pr-tick, review-requested,
# unstick, automerge, settle, close, pr-board, done, metrics e merge-policy
# saíram daqui: rodam no workflow "Board do GitHub → Rastreio" da Rendeira, na
# mesma ordem (ADR 0012 da rendeira). prep e notify ficam até virarem.
# Por último: avisa no Telegram o que parou esperando humano (PR pra mergear,
# issue travada). Depois do pr-board, que é quem põe o card do PR em Ready.
ExecStart=%h/.local/bin/gh-tick-step gh:notify
StandardOutput=journal
StandardError=journal
