[Unit]
# O workflow "Item added to project" do GitHub só aplica default a UM campo
# (Status). Priority fica de fora, então quem preenche é o `task gh:defaults`.
Description=Tick do GitHub Project "Agentes" — sync, despacho das issues em Ready e ciclo dos PRs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/home/alvaro/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=%h
# Issue/PR novos entram no board sozinhos; o `sync` termina chamando `defaults`.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:sync
# Antes do pr-tick: PR cujo agente morreu volta pra fila no mesmo tick.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:reap
# PR que ele mergeou devolve a issue pra Ready, pra o /issue-prep reavaliar.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:reanalyze
# Ready -> worktree Orca com agente. Sai em silêncio se o Orca estiver fora.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:dispatch
# PR do fluxo -> revisar / corrigir / aprovar. O merge é dele. Idem: no-op sem Orca.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:pr-tick
# Fecha o ciclo no board: item fechado/merged sai de "In Progress".
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:done
StandardOutput=journal
StandardError=journal
