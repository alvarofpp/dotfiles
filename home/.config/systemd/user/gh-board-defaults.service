[Unit]
# Tick do fluxo autônomo. O estado é o Status da issue no board — cada ExecStart
# lê uma coluna e age. A ordem importa: liberar lock e destravar Blocked vem
# antes de despachar, pra o que destravou entrar no mesmo tick.
Description=Tick do GitHub Project "Agentes" — triagem, implementação, review e fechamento
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/home/alvaro/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=%h
# Vigia do portão: avisa no Telegram quando o fluxo passa 3 ticks desligado.
# Primeiro de propósito — é o que responde "este tick vale alguma coisa?".
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:gate-watch
# Issue e PR novos entram no board; o `sync` termina chamando `defaults`.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:sync
# Issue cujo agente morreu perde o lock e volta pra fila.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:reap
# Blocked que já teve resposta humana volta pra In Progress.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:unblock
# Pergunta sua com prefixo impl:/review:/agent: ganha o time que responde.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:answer
# Ready -> triagem (/issue-prep). Síncrono: nada de worktree nesta fase.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:prep
# In Progress -> agente implementando, ou aplicando o que a revisão pediu.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:dispatch
# In Review -> ciclo de revisão do PR. Para em agent:approved; o merge é dele.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:pr-tick
# PR de outra pessoa que pediu revisão sua: despacha o revisor.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:review-requested
# PR aprovado que parou de mesclar (conflito, atrasado, CI vermelho).
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:unstick
# PR aprovado que o filtro liberar mescla sozinho. Inerte enquanto não existir
# `~/.local/state/gh-board/automerge` — que é o default, e é como isto entra no
# tick sem mudar nada até você optar. Depois do `unstick`, que é quem põe o PR
# aprovado em dia, e antes do `settle`, pra o que mesclou agora fechar no mesmo
# tick.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:automerge
# In Review sem PR aberto -> confere critérios de aceite e decide Done.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:settle
# Done/Dropped -> fecha a issue e apaga a worktree.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:close
# Card de PR ganha Status próprio (In Review / Ready-é-seu / Blocked / Done).
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:pr-board
# Higiene: item fechado fora do fluxo sai do Status antigo.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:done

# Higiene de settings: repõe o squash-only que alguém tenha desfeito pela UI.
# Autolimitado a uma passada por dia (`EVERY` no gh:merge-policy) — rodar a
# cada tick custaria uma chamada de API por repo pra consertar um desvio raro.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:merge-policy
# Por último: avisa no Telegram o que parou esperando humano (PR pra mergear,
# issue travada). Depois do pr-board, que é quem põe o card do PR em Ready.
ExecStart=/home/linuxbrew/.linuxbrew/bin/task gh:notify
StandardOutput=journal
StandardError=journal
